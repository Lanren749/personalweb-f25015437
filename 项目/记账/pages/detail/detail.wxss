.page {
  padding: 28rpx 30rpx 56rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #edf0f2;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(29, 53, 72, 0.045);
}

.hero {
  padding: 32rpx;
  background: linear-gradient(145deg, #f2faf6 0%, #ffffff 76%);
  border-color: #e5f1eb;
}

.eyebrow {
  color: #6d9b85;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.heading {
  margin-top: 8rpx;
  color: #1f3029;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.4;
}

.month-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.month-label {
  color: #30443b;
  font-size: 31rpx;
  font-weight: 700;
}

.month-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  color: #347956;
  background: #e7f3eb;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
}

.month-arrow::after,
.delete-button::after {
  border: 0;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 38rpx 4rpx 18rpx;
}

.section-title {
  color: #27372f;
  font-size: 30rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 4rpx;
  color: #87938c;
  font-size: 21rpx;
}

.count-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #55806a;
  background: #eaf4ee;
  font-size: 22rpx;
}

.expense-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.expense-card {
  padding: 25rpx 26rpx 17rpx;
}

.expense-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.expense-copy {
  min-width: 0;
  flex: 1;
}

.expense-note {
  overflow: hidden;
  color: #2d3b34;
  font-size: 28rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.expense-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 11rpx;
  color: #8a958f;
  font-size: 21rpx;
}

.expense-area {
  max-width: 220rpx;
  overflow: hidden;
  color: #538368;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-dot {
  color: #c0c8c3;
}

.expense-amount {
  flex: none;
  color: #a84848;
  font-size: 30rpx;
  font-weight: 700;
  white-space: nowrap;
}

.expense-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 15rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f2f1;
}

.edit-hint {
  color: #a0aaa4;
  font-size: 20rpx;
}

.delete-button {
  height: 54rpx;
  margin: 0 -8rpx 0 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 12rpx;
  color: #b34444;
  background: #fff0ef;
  font-size: 22rpx;
  line-height: 54rpx;
}

.empty,
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54rpx 32rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 26rpx;
  color: #3a9469;
  background: #eaf6ef;
  font-size: 44rpx;
}

.empty-title {
  margin-top: 22rpx;
  color: #2e3d35;
  font-size: 27rpx;
  font-weight: 700;
}

.state-card {
  flex-direction: row;
  justify-content: center;
  gap: 16rpx;
  color: #7c8982;
  font-size: 23rpx;
}

.loader-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #58a77c;
}

.refreshing {
  padding: 20rpx 0;
  color: #87938c;
  font-size: 21rpx;
  text-align: center;
}
