.page {
  padding: 28rpx 30rpx 56rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #edf0f2;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(29, 53, 72, 0.045);
}

.hero {
  padding: 32rpx;
  background: linear-gradient(145deg, #f2faf6 0%, #ffffff 76%);
  border-color: #e5f1eb;
}

.eyebrow {
  color: #6d9b85;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.heading {
  margin-top: 8rpx;
  color: #1f3029;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
}

.month-line {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: #30443b;
  font-size: 26rpx;
  font-weight: 600;
}

.month-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #3e9b70;
}

.month-caption {
  margin-left: 14rpx;
  color: #829189;
  font-size: 22rpx;
  font-weight: 400;
}

.hero-actions,
.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.button::after {
  border: 0;
}

.button-primary {
  color: #ffffff;
  background: #25885e;
}

.button-secondary {
  color: #286e50;
  background: #e5f3eb;
}

.button-quiet {
  color: #5f6f67;
  background: #f0f3f1;
}

button[disabled] {
  opacity: 0.58;
}

.editor {
  margin-top: 24rpx;
  padding: 30rpx;
  border-color: #dcebe2;
}

.editor-heading {
  margin-bottom: 22rpx;
  color: #20342b;
  font-size: 30rpx;
  font-weight: 700;
}

.field {
  min-width: 0;
  margin-top: 18rpx;
}

.field-row {
  display: flex;
  gap: 18rpx;
}

.field-grow {
  flex: 1;
}

.sort-field {
  width: 190rpx;
  flex: none;
}

.field-label {
  margin-bottom: 10rpx;
  color: #65746c;
  font-size: 22rpx;
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e5eae7;
  border-radius: 14rpx;
  color: #21332a;
  background: #fbfcfb;
  font-size: 26rpx;
}

.editor-actions {
  margin-top: 28rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 38rpx 4rpx 18rpx;
}

.section-title {
  color: #27372f;
  font-size: 30rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 4rpx;
  color: #87938c;
  font-size: 21rpx;
}

.count-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #55806a;
  background: #eaf4ee;
  font-size: 22rpx;
}

.area-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.area-card {
  padding: 26rpx 28rpx 24rpx;
}

.area-topline,
.area-name-wrap,
.area-actions {
  display: flex;
  align-items: center;
}

.area-topline {
  justify-content: space-between;
}

.area-mark {
  width: 10rpx;
  height: 34rpx;
  margin-right: 14rpx;
  border-radius: 8rpx;
  background: #52a67c;
}

.area-name {
  max-width: 330rpx;
  overflow: hidden;
  color: #27382f;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.area-actions {
  gap: 10rpx;
}

.text-action {
  min-width: 66rpx;
  height: 54rpx;
  margin: 0;
  padding: 0 8rpx;
  border: 0;
  color: #5c7567;
  background: transparent;
  font-size: 23rpx;
  line-height: 54rpx;
}

.text-action::after {
  border: 0;
}

.text-danger {
  color: #b55b58;
}

.metrics {
  display: flex;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #f0f2f1;
}

.metric {
  flex: 1;
  min-width: 0;
}

.metric + .metric {
  padding-left: 18rpx;
}

.metric-label {
  color: #929d96;
  font-size: 21rpx;
}

.metric-value {
  margin-top: 5rpx;
  color: #3a4a42;
  font-size: 27rpx;
  font-weight: 600;
  white-space: nowrap;
}

.metric-remaining .metric-label {
  color: #5d8a70;
}

.remaining-value {
  color: #26774f;
}

.danger {
  color: #c23d3d;
}

.overspent-note {
  margin-top: 18rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  color: #b33d3d;
  background: #fff0ef;
  font-size: 23rpx;
  font-weight: 600;
}

.empty,
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54rpx 32rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 26rpx;
  color: #3a9469;
  background: #eaf6ef;
  font-size: 52rpx;
  font-weight: 300;
}

.empty-title {
  margin-top: 22rpx;
  color: #2e3d35;
  font-size: 29rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 8rpx;
  color: #89958e;
  font-size: 23rpx;
}

.empty-button {
  width: 300rpx;
  flex: none;
  margin-top: 28rpx;
}

.state-card {
  flex-direction: row;
  justify-content: center;
  gap: 16rpx;
  color: #7c8982;
  font-size: 23rpx;
}

.loader-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #58a77c;
}

.footer-note {
  margin: 26rpx 8rpx 0;
  color: #99a39d;
  font-size: 20rpx;
  text-align: center;
}
