# 无域名阶段：仅服务器本机监听，通过 SSH 隧道访问。
# 主服务固定绑定 127.0.0.1:18080；公开只读服务独立绑定 18081。
APP_ORIGIN=http://localhost:18080
# 旧版单人密码，仅用于首次迁移旧个人数据；新用户通过网页注册。
ADMIN_PASSWORD_HASH=
# 首次部署运行 node scripts/setup-data-key.mjs；用于加密每个账号的 DeepSeek Key。
DATA_ENCRYPTION_KEY=
# 旧版个人空间迁移后的 owner 邮箱；新访客直接在 HTTPS 页面注册，不需要共享密码。
OWNER_EMAIL=owner@local.invalid
# 北京时间。只定时采集公开来源，不自动调用付费 AI。
REFRESH_TIME=09:00
# 仅用于旧版单人数据首次迁移；新账号在网页“我的偏好”中保存各自的 Key。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_DAILY_LIMIT=5
# 仅反向代理正确覆盖 X-Forwarded-Proto 且限制上游访问后设置 1。
TRUST_PROXY=0
